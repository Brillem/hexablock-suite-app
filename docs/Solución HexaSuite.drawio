        <mxCell id="l4I-vUo4QrZHaf3PINGu-79" parent="l4I-vUo4QrZHaf3PINGu-78" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];defaultLabelBackgroundColor=page;fontSize=12;" value="board  1" vertex="1">
          <mxGeometry relative="1" x="0.85" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-80" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=14;fontSize=11;" value="&lt;b&gt;Corrección 4 · El tablero vive solo en GameContext&lt;/b&gt;&lt;br&gt;Se quitó board de GameEngine y de GameRules:&lt;br&gt;había tres copias que podían desincronizarse.&lt;br&gt;Las reglas no guardan estado: reciben un TContext&lt;br&gt;y devuelven otro. Todas las firmas reciben TContext.&lt;br&gt;También se quitó (TCoordinate extends ...) de&lt;br&gt;GameRules, que quedó de la versión anterior." vertex="1">
          <mxGeometry height="135" width="310" x="1430" y="2375" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-81" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=14;fontSize=11;" value="&lt;b&gt;Cómo leer las correcciones&lt;/b&gt;&lt;br&gt;Texto verde: lo agregó o cambió la corrección.&lt;br&gt;Borde verde: clase nueva.&lt;br&gt;Recuadros azules de abajo: propuestas para&lt;br&gt;discutir, todavía no aplicadas.&lt;br&gt;Al aceptar un cambio, se le puede quitar el color." vertex="1">
          <mxGeometry height="120" width="310" x="1430" y="2585" as="geometry" />
