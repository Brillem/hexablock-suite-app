        <mxCell id="l4I-vUo4QrZHaf3PINGu-100" parent="l4I-vUo4QrZHaf3PINGu-98" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=#4CAF50;strokeWidth=2;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;LinesFactory&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;bind&amp;gt;&amp;gt; TCellValue = Color, TContext = LinesContext&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;TMove = PlacePiece&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ createBoard(level) : &lt;span style=&quot;color: light-dark(transparent, rgb(0, 255, 128));&quot;&gt;IBoard&amp;lt;Color&amp;gt;&lt;/span&gt;&amp;nbsp;{hexágono radio 4}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ createInitialState(board, level) : LinesContext&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ createRules() : GameRules  {DragMovement + LinesResolution + LinesScorePolicy}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ createPieceSource(level) : SeededPieceSource&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ createHistory() : null  {sin deshacer}&lt;/p&gt;" vertex="1">
