        <mxCell id="l4I-vUo4QrZHaf3PINGu-94" parent="l4I-vUo4QrZHaf3PINGu-93" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];defaultLabelBackgroundColor=page;fontSize=12;" value="events  0..*" vertex="1">
