        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-74" parent="l4I-vUo4QrZHaf3PINGu-73" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];defaultLabelBackgroundColor=page;fontSize=12;" value="0..1" vertex="1">
          <mxGeometry relative="1" x="-0.6" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-75" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=14;fontSize=11;" value="&lt;b&gt;Corrección 6 · Deshacer (Memento + Prototype)&lt;/b&gt;&lt;br&gt;GameEngine = originator, la copia de TContext = memento,&lt;br&gt;History = caretaker: guarda copias sin mirar dentro.&lt;br&gt;Antes de cada movimiento:&lt;br&gt;history?.save(currentState.clone()).&lt;br&gt;clone() es Prototype: el motor no conoce la clase&lt;br&gt;concreta de TContext.&lt;br&gt;clone() debe ser PROFUNDO: copia el tablero y también&lt;br&gt;los valores mutables de las celdas (Stack).&lt;br&gt;Fit ilimitado, Merge 1, Lines y Sort sin historial." vertex="1">
          <mxGeometry height="180" width="330" x="2820" y="2428" as="geometry" />
        </mxCell>
