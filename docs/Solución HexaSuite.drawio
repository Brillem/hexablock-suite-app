          </mxGeometry>
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-153" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=#4CAF50;strokeWidth=2;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;FitScorePolicy&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;{Hexa Fit}&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- maxMoves: number [3] {del nivel}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- maxTime: number [3] {del nivel}&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ calculateScoreDelta(context: FitContext, events: GameEvent [ ]) : number&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;     {valor del intento según moves y elapsedTime menos currentScore}&lt;/p&gt;" vertex="1">
          <mxGeometry height="174" width="499" x="2549" y="2914" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-154" edge="1" parent="1" source="l4I-vUo4QrZHaf3PINGu-153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;endArrow=block;endFill=0;endSize=30;dashed=1;dashPattern=12 12;exitX=0.5;exitY=0;entryX=0;entryY=0.460;" target="l4I-vUo4QrZHaf3PINGu-33">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2798.5" y="2899" />
              <mxPoint x="3291.5" y="2899" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-155" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=14;fontSize=11;" value="&lt;b&gt;Clases concretas · cómo se cierran los genéricos&lt;/b&gt;&lt;br&gt;GameEngine&amp;lt;TCellValue, TContext, TMove&amp;gt; por variante:&lt;br&gt;· Lines: GameEngine&amp;lt;Color, LinesContext, PlacePiece&amp;gt;&lt;br&gt;· Sort:  GameEngine&amp;lt;Stack, SortContext, PlacePiece&amp;gt;&lt;br&gt;· Merge: GameEngine&amp;lt;number, MergeContext, Coordinate&amp;gt;&lt;br&gt;· Fit:   GameEngine&amp;lt;number, FitContext, FitMove&amp;gt;&lt;br&gt;Cada fábrica configura movimiento, resolución y política de puntaje.&lt;br&gt;Las cuatro políticas calculan el delta de la jugada.&lt;br&gt;El motor no cambia: no hay ningún if por variante (LSP del enunciado).&lt;br&gt;La bandeja vive en el contexto concreto: Merge no tiene bandeja." vertex="1">
          <mxGeometry height="165" width="640" x="420" y="3014" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-156" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=14;fontSize=11;" value="&lt;b&gt;Pendiente que dejan a la vista&lt;/b&gt;&lt;br&gt;1. Lines puntúa «celdas colocadas» y Merge «valor de cada fusión»,&lt;br&gt;   pero ambas cosas pasan en el movimiento, no en la resolución.&lt;br&gt;   → Movement también debería devolver GameEvent [ ] (o un PiecePlaced). ---&amp;gt; Solucionado, ahora devuelve un ResolutionContext (Creo que habria que cambiarle el nombre a la clase lol)&lt;br&gt;2. ¿Quién rellena la bandeja de Lines y Sort cuando se vacía?&amp;nbsp;&lt;br&gt;   GameEngine tiene pieceSource, pero no conoce la bandeja (es genérico).---&amp;gt; Solucionado, el generador de piezas se encuentra ahora en las resoluciónes que lo necesiten y no en el engine&lt;br&gt;3. FitContext.elapsedTime: el dominio no lee el reloj; la aplicación&lt;br&gt;   le pasa el tiempo transcurrido.&lt;br&gt;4. FitContext.moves: falta quién lo incrementa. Propuesta: DragAndReplaceMovement&lt;br&gt;   devuelve el contexto con moves + 1 en cada jugada válida (colocar/retirar/rotar).&lt;br&gt;   A decidir: como moves vive en el contexto, deshacer lo restaura (el movimiento&lt;br&gt;   «se devuelve»). Si deshacer debe contar como movimiento para las estrellas,&lt;br&gt;   el contador tiene que vivir fuera de lo que guarda History. ----&amp;gt; El cambio de aumentar el número de movimientos se encarga el Game Engine dentro de applyMovement, independientemente de que movimiento sea el aplicado" vertex="1">
          <mxGeometry height="225" width="660" x="420" y="3220" as="geometry" />
        </mxCell>
        <mxCell id="l4I-vUo4QrZHaf3PINGu-157" edge="1" parent="1" source="l4I-vUo4QrZHaf3PINGu-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;endArrow=open;endFill=0;endSize=30;exitX=-0.002;exitY=0.15;exitDx=0;exitDy=0;exitPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;">
          <mxGeometry relative="1" x="-0.0006" as="geometry">
            <Array as="points">
              <mxPoint x="3200" y="3779.4" />
              <mxPoint x="3200" y="3390" />
              <mxPoint x="3130" y="3390" />
            </Array>
            <mxPoint x="3120" y="3740" as="sourcePoint" />
            <mxPoint x="3130" y="3350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=9;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="El contexto tiene un genérico que es el propio genérico, esto es para que la clonación en las implementaciones concretas puedan devolverse a si misma y no tengamos que hacer type casting" vertex="1">
          <mxGeometry height="80" width="160" x="2053" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=8;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Se le cambio el nombre (Anteriormente&amp;nbsp;ReadablePieceSource) y también su atributo de la fuente, como estamos en el dominio no podemos depender semántica ni lógicamente de otras capas" vertex="1">
          <mxGeometry height="110" width="180" x="2002" y="640" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-7" edge="1" parent="1" source="xU8Kh8ebQqSexFp26DgA-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;endSize=30;endArrow=block;endFill=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4740" y="950" />
              <mxPoint x="4160" y="950" />
            </Array>
            <mxPoint x="4741.5" y="1140" as="sourcePoint" />
            <mxPoint x="4160" y="872" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=#4CAF50;strokeWidth=2;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;PiecePlaced&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;{Hexa Lines}&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ numberOfCells: Number&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="158" width="240" x="4620" y="982" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-10" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=8;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Hice que lregresase un resolutionResult (Se le puede cambiar el nombre a la clase ahora que no solo lo usa la resolución) porque hay eventos necesarios para el cálculo de puntos, como en HexaLines que cuantas celdas colocas te da puntaje, y eso realmente por como está ahorita todo planteado solo podría saberse aquí en el movimiento" vertex="1">
          <mxGeometry height="107" width="171" x="4529" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-11" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=9;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Quité el piecesource de aquí pues en la mayoría de juegos la generación de piezas se puede delegar a la resolución (Se ejecutan bajo cierta condición despues de solucionar la partida, solo no sucedia así en HexaFit (Inicio de partida) Pero de eso se debería encargar la fabrica abstracta al inicializar el juego, no el Engine" vertex="1">
          <mxGeometry height="95" width="203.5" x="2290" y="2326" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-12" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=11;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Moví el contador de movimientos realizados al contexto compartido, porque aunque solo sirva para el calculo de puntaje en Hexa Fit, nos puede permitir calcular bonus y otras cosas en otros juegos + así no hace falta declarar el contexto concreto en dragAndReplace" vertex="1">
          <mxGeometry height="120" width="180" x="1570" y="2130" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-22" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=9;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Hice que tanto GameRules como Game Engine dejasen de ser abstractas, realmente por como las planteamos no las veo teniendo subclases por juego, al final ambas realmente se encargan de delegar" vertex="1">
          <mxGeometry height="90" width="150" x="3017.5" y="1957.5" as="geometry" />
        </mxCell>
        <mxCell id="xU8Kh8ebQqSexFp26DgA-23" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad9d5;strokeColor=#ae4132;fillStyle=solid;fontSize=11;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Puse que tuviese los valores de las piezas que tiene que construir en rawValues, pero realmente no se como estamos pensando que funcione el pieceFactory, como al metodo le entra un número lol, hay que ver bien esta parte" vertex="1">
          <mxGeometry height="110" width="180" x="2002" y="795" as="geometry" />
        </mxCell>
        <mxCell id="fJGpXaArP9bKYrMy7mMK-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad7ac;strokeColor=#b46504;fillStyle=solid;fontSize=15;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Como yo lo pensé era usar números para generar valores aleatorios (Colores, numeros, ids, etc) pero cualquier cosa podemos poner un parámetro genérico de entrada&lt;br&gt;- O" vertex="1">
          <mxGeometry height="140" width="216.5" x="1902" y="904" as="geometry" />
        </mxCell>
        <mxCell id="fJGpXaArP9bKYrMy7mMK-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad7ac;strokeColor=#b46504;fillStyle=solid;fontSize=14;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Oigan aquí el TMove necesita más cosas porque si recuerdan el profe nos dijo que no hicieramos el 2048 moviendo todo el tablero sino moviendo una pieza y que esa pieza sería la que colisiona y se junta con otras dependiendo de si puede o no&lt;br&gt;- O" vertex="1">
          <mxGeometry height="158" width="240" x="4790" y="2320" as="geometry" />
        </mxCell>
        <mxCell id="fJGpXaArP9bKYrMy7mMK-6" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad7ac;strokeColor=#b46504;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Ahora se llama calculateScoreDelta porque solo tiene que regresar la puntuación obtenida a raíz de los GameEvent y changeScore se encarga de modificar el score del contexto y regresarlo&amp;nbsp;&lt;br&gt;- O" vertex="1">
          <mxGeometry height="115" width="400" x="3000" y="2660" as="geometry" />
        </mxCell>
        <mxCell id="fJGpXaArP9bKYrMy7mMK-7" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#fad7ac;strokeColor=#b46504;fillStyle=solid;fontSize=23;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="Q por cierto hay que hacer los ValueObjects de los diferentes TMove&lt;br&gt;- O" vertex="1">
          <mxGeometry height="115" width="400" x="5000" y="2220" as="geometry" />
        </mxCell>
