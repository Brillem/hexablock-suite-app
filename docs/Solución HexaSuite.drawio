        <mxCell id="progress-domain-fit-extends" edge="1" parent="progress-domain-region" source="progress-domain-fit-entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=default;endArrow=block;endFill=0;exitX=0.5;exitY=1;entryX=0.88;entryY=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;endSize=30;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="progress-domain-entry">
